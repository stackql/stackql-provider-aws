{
  "name": "stackql-provider-aws",
  "version": "0.1.0",
  "description": "StackQL Provider for AWS",
  "type": "module",
  "scripts": {
    "generate-docs": "./stackql-provider/bin/generate-docs.sh",
    "generate-mappings": "./stackql-provider/bin/generate-mappings.sh",
    "generate-provider": "./stackql-provider/bin/generate-provider.sh",
    "start-server": "bash ./stackql-provider/bin/start-server.sh",
    "stop-server": "bash ./stackql-provider/bin/stop-server.sh",
    "server-status": "bash ./stackql-provider/bin/server-status.sh",
    "test-meta-routes": "node ./stackql-provider/bin/test-meta-routes.cjs"
  },
  "dependencies": {
    "@stackql/pgwire-lite": "^1.0.1",
    "@stackql/provider-utils": "^0.5.3"
  },
  "keywords": [
    "stackql",
    "aws",
    "provider"
  ],
  "engines": {
    "node": ">=14.16.0"
  }
}